# Personal Telegram Assistant powered by Claude
# Copy this file to .env (which is gitignored) OR store secrets in the OS Credential Manager
# using: python -m telegram_assistant set-secret TELEGRAM_BOT_TOKEN
#        python -m telegram_assistant set-secret ANTHROPIC_API_KEY
#
# NEVER commit real tokens or API keys to source control.

# --- Required Secrets (leave blank here; set in .env, environment, or OS keyring) ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# --- Required Owner Access Control (numeric Telegram IDs, private chat only) ---
OWNER_USER_ID=
OWNER_CHAT_ID=

# --- Claude Model & Token Pricing (confirm current rates for chosen model) ---
CLAUDE_MODEL=claude-sonnet-4-6
INPUT_COST_PER_MILLION_USD=3.00
OUTPUT_COST_PER_MILLION_USD=15.00
MONTHLY_BUDGET_USD=20.00

# --- Local Paths ---
APPROVED_FOLDER=./assistant_folder
DB_PATH=./data/assistant.db
LOG_DIR=./logs
BACKUP_DIR=./backups
STOP_FILE=./STOP_REQUESTED

# --- Bounds & Limits ---
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=24000
MAX_OUTPUT_TOKENS=1024
MAX_TOOL_STEPS=5
MAX_FILE_BYTES=262144
MAX_EXCERPT_CHARS=12000
JOB_TIMEOUT_SECONDS=90
API_TIMEOUT_SECONDS=45
MAX_API_RETRIES=3
MAX_CONCURRENT_JOBS=1
LONG_JOB_ACK_SECONDS=3.0

# --- Approvals, Retention & Stale Request Policy ---
APPROVAL_TTL_SECONDS=300
RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30
STALE_TASK_MAX_AGE_SECONDS=600

# --- Controlled Laptop Actions (allowlisted apps & confirmation-gated power controls) ---
ENABLE_SYSTEM_CONTROL=true
CONFIRM_OPEN_APP=false
SHUTDOWN_DELAY_SECONDS=60

# --- Telegram Network Settings ---
TELEGRAM_CONNECT_TIMEOUT=20.0
TELEGRAM_READ_TIMEOUT=30.0
TELEGRAM_WRITE_TIMEOUT=20.0
TELEGRAM_POOL_TIMEOUT=20.0
TELEGRAM_FORCE_IPV4=true
TELEGRAM_PROXY=

# --- Logging (metadata-only by default; keep false in normal use) ---
LOG_LEVEL=INFO
USE_OS_KEYRING=true
KEYRING_SERVICE_NAME=personal-telegram-claude-assistant
